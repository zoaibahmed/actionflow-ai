{
  "name": "actionflow-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint",
    "db:migrate": "node scripts/migrate.mjs",
    "test": "tsx --test tests/*.test.ts",
    "test:db": "tsx --test tests/database.integration.ts",
    "mail:latest": "node scripts/mail-latest.mjs",
    "test:auth": "tsx --test tests/auth.integration.ts",
    "test:capture": "tsx --test tests/capture.integration.ts",
    "test:ai": "node --conditions=react-server --import tsx --test tests/capture-service.integration.ts tests/planner-service.integration.ts",
    "test:planner": "tsx --test tests/planner.integration.ts",
    "reminders:setup": "node scripts/configure-reminders.mjs",
    "reminders:once": "node --conditions=react-server --import tsx scripts/reminder-worker.mts --once",
    "reminders:work": "node --conditions=react-server --import tsx scripts/reminder-worker.mts",
    "test:reminders": "node --conditions=react-server --import tsx --test tests/reminders.integration.ts",
    "test:agent": "node --conditions=react-server --import tsx --test tests/agent.integration.ts",
    "test:agent:http": "tsx --test tests/agent-http.integration.ts",
    "test:auth:mail": "node --conditions=react-server --import tsx --test tests/auth-mail.integration.ts",
    "test:auth:google": "node --conditions=react-server --import tsx --test tests/auth-google.integration.ts",
    "email:check": "node --conditions=react-server --import tsx scripts/check-email.mts",
    "test:workspace": "node --conditions=react-server --import tsx --test tests/workspace.integration.ts",
    "test:workspace:http": "tsx --test tests/workspace-http.integration.ts",
    "config:check": "node --import tsx scripts/check-production.mts",
    "secrets:check": "node --import tsx scripts/check-client-secrets.mts",
    "test:production:http": "tsx --test tests/production-http.integration.ts"
  },
  "dependencies": {
    "@better-auth/mongo-adapter": "^1.7.11",
    "@js-temporal/polyfill": "^0.5.1",
    "better-auth": "^1.7.11",
    "lucide-react": "^1.59.0",
    "mongodb": "^7.7.0",
    "motion": "^14.4.0",
    "next": "16.4.2",
    "nodemailer": "^10.1.7",
    "openai": "^7.39.0",
    "pdf-lib": "^1.17.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "axe-core": "^4.14.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=24"
  }
}
