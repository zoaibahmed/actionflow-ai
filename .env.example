MONGODB_URI=
MONGODB_DB=actionflow_ai
BETTER_AUTH_URL=http://localhost:3000
# Generate a random secret of at least 32 characters; never commit it.
BETTER_AUTH_SECRET=
# Local mailbox supports development verification. Configure SMTP for production.
# Email verification and email OTP are mandatory; no bypass flag.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_MODE=file
# Production uses SMTP; file mailbox is ignored under NODE_ENV=production.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
CAPTURE_DAILY_LIMIT=20
# Optional AI request timeout, bounded to 1000–55000 ms.
CAPTURE_TIMEOUT_MS=55000
PLANNER_DAILY_LIMIT=20
# Durable reminder processor. Generate with npm run reminders:setup.
REMINDER_INTERVAL_MS=60000
REMINDER_WORKER_SECRET=
# Optional real browser push. Generate keys once, keep private key server-side.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Agent: bounded natural-language requests per user per UTC day.
AGENT_DAILY_LIMIT=20

# Better Auth Google redirect login (server-only; leave blank until configured).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only for isolated provider mocks; leave unset in production.
# OPENAI_BASE_URL=
# Optional stable build encryption key, generated once and protected like a secret.
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
# Local profiling/QA only; never enable on an exposed server.
DIAGNOSTICS_ENABLED=0
# Set NODE_ENV=production in the service EnvironmentFile; development scripts set their own mode.
