[Unit]
Description=ActionFlow durable reminder worker
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=actionflow
Group=actionflow
WorkingDirectory=/opt/actionflow/current
Environment=NODE_ENV=production
EnvironmentFile=/etc/actionflow/actionflow.env
ExecStart=/usr/bin/node --conditions=react-server --import tsx scripts/reminder-worker.mts
Restart=on-failure
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=90
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/actionflow
StandardOutput=journal
StandardError=journal
SyslogIdentifier=actionflow-worker
MemoryAccounting=true
TasksMax=256

[Install]
WantedBy=multi-user.target
